# DishaSetu Server Configuration Example
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/dishaSetu_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dishaSetu_db?retryWrites=true&w=majority

# JWT & Admin Secret
JWT_SECRET=your_jwt_secret_key_here
ADMIN_API_KEY=your_admin_api_key_here

# Campus Default Configuration
CAMPUS_NAME="Presidency University Bengaluru"
DEFAULT_LAT=13.1717995
DEFAULT_LNG=77.5361915
DEFAULT_ZOOM=18
